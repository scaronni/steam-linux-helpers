#!/usr/bin/env python3
"""Show which DLSS preset the driver "latest" override (0x00FFFFFF) selects.

Works on nvngx_dlss*.dll (PE) and libnvidia-ngx-dlss*.so (ELF), x86-64 only.
Static analysis via objdump; the mapping is not exported anywhere, so this
follows the code that handles the DRS render preset override value:

  1. Find where the SR/RR/FG "render preset selection" DRS setting is loaded,
     then interpret the code from there with the value set to 0x00FFFFFF, once
     per quality mode, to see which preset gets stored.
  2. Newer libraries re-check 0x00FFFFFF in the per-mode preset helper and
     substitute that mode's built-in default preset; when that helper is found,
     the per-mode defaults passed to it are what is actually used.
"""

import re
import subprocess
import sys

DRS_SR_PRESET = 0x10E41DF3  # NGX_DLSS_SR_OVERRIDE_RENDER_PRESET_SELECTION
DRS_RR_PRESET = 0x10E41DF7  # NGX_DLSS_RR_OVERRIDE_RENDER_PRESET_SELECTION
DRS_FG_PRESET = 0x10E41DF1  # NGX_DLSS_FG_OVERRIDE_RENDER_PRESET_SELECTION
DRS_FG_MFG_COUNT = 0x104D6667  # NGX_DLSSG_MULTI_FRAME_COUNT
LATEST = 0x00FFFFFF

# NVSDK_NGX_PerfQuality_Value order, with the hint parameter suffix for each.
MODES = [
    ("Performance", "Performance"),
    ("Balanced", "Balanced"),
    ("Quality", "Quality"),
    ("Ultra Performance", "UltraPerformance"),
    ("Ultra Quality", "UltraQuality"),
    ("DLAA", "DLAA"),
]
MAX_PRESET = 26

INSN_RE = re.compile(r"^\s*([0-9a-f]+):\s+(\S+)\s*(.*)$")
REF_RE = re.compile(r"#\s*(?:0x)?([0-9a-f]+)")
CALLER_SAVED = {
    "pe": {"rax", "rcx", "rdx", "r8", "r9", "r10", "r11"},
    "elf": {"rax", "rcx", "rdx", "rsi", "rdi", "r8", "r9", "r10", "r11"},
}
REG_ALIASES = {
    "a": "rax", "b": "rbx", "c": "rcx", "d": "rdx",
    "si": "rsi", "di": "rdi", "bp": "rbp", "sp": "rsp",
}


def preset_name(v):
    return f"{chr(ord('A') + v - 1)} ({v})" if 1 <= v <= MAX_PRESET else f"? ({v})"


def canon_reg(op):
    op = op.strip()
    m = re.fullmatch(r"r(\d+)[dwb]?", op)
    if m:
        return f"r{m.group(1)}"
    m = re.fullmatch(r"[re]?([abcd])[xlh]|[re]?(si|di|bp|sp)l?", op)
    if m:
        return REG_ALIASES[m.group(1) or m.group(2)]
    return None


def imm(op):
    op = op.strip()
    if re.fullmatch(r"-?0x[0-9a-f]+|-?\d+", op):
        return int(op, 0) & 0xFFFFFFFF
    return None


def target(op):
    """Direct branch/call target: '0x18003f3fd' (PE) or '30230 <sym+0x..>' (ELF)."""
    m = re.fullmatch(r"(?:0x)?([0-9a-f]+)(?:\s+<.*>)?", op.strip())
    return int(m.group(1), 16) if m else None


def is_mem(op):
    return "[" in op


class Binary:
    def __init__(self, path):
        self.path = path
        self.data = open(path, "rb").read()
        self.abi = "pe" if self.data[:2] == b"MZ" else "elf"
        self.sections = self._sections()
        self.insns = []
        self.index = {}
        out = subprocess.run(
            ["objdump", "-d", "--no-show-raw-insn", "-M", "intel", path],
            capture_output=True, text=True, check=True).stdout
        for line in out.splitlines():
            m = INSN_RE.match(line)
            if not m:
                continue
            addr, mnem, ops = int(m.group(1), 16), m.group(2), m.group(3)
            ref = REF_RE.search(ops)
            ops = ops.split("#")[0].strip()
            self.index[addr] = len(self.insns)
            self.insns.append((addr, mnem, ops, int(ref.group(1), 16) if ref else None))

    def _sections(self):
        out = subprocess.run(["objdump", "-h", self.path],
                             capture_output=True, text=True, check=True).stdout
        secs = []
        for line in out.splitlines():
            p = line.split()
            if len(p) >= 6 and p[0].isdigit():
                size, vma, off = int(p[2], 16), int(p[3], 16), int(p[5], 16)
                secs.append((off, vma, size))
        return secs

    def vaddrs_of(self, s):
        """Virtual addresses of every NUL-terminated occurrence of s."""
        needle = s.encode() + b"\0"
        res, pos = [], self.data.find(needle)
        while pos != -1:
            if pos == 0 or self.data[pos - 1] == 0:
                for off, vma, size in self.sections:
                    if off <= pos < off + size:
                        res.append(pos - off + vma)
            pos = self.data.find(needle, pos + 1)
        return res

    def version(self):
        key = "FileVersion".encode("utf-16-le") + b"\0\0"
        pos = self.data.find(key)
        if pos != -1:
            pos += len(key)
            while self.data[pos:pos + 2] == b"\0\0":
                pos += 2
            end = pos
            while self.data[end:end + 2] != b"\0\0":
                end += 2
            return self.data[pos:end].decode("utf-16-le", "replace").replace(",", ".").replace(" ", "")
        m = re.search(r"\.so\.([\d.]+)$", self.path)
        return m.group(1) if m else "unknown"

    def preset_notes(self):
        """{preset: text} from FG log lines like "Preset B selected, enabling UIR"."""
        return {ord(m.group(1)) - ord("A") + 1: m.group(2).decode()
                for m in re.finditer(rb"Preset ([A-Z]) selected, ([^\0.]+)", self.data)}

    def refs_to_imm(self, value):
        pat = re.compile(rf",0x{value:x}$")
        return [i for i, (_, _, ops, _) in enumerate(self.insns) if pat.search(ops)]


def cond_taken(mnem, flags):
    a, b = flags
    sa = a - (1 << 32) if a & 0x80000000 else a
    sb = b - (1 << 32) if b & 0x80000000 else b
    diff = (a - b) & 0xFFFFFFFF
    return {
        "je": a == b, "jz": a == b, "jne": a != b, "jnz": a != b,
        "ja": a > b, "jnbe": a > b, "jae": a >= b, "jnb": a >= b, "jnc": a >= b,
        "jb": a < b, "jc": a < b, "jnae": a < b, "jbe": a <= b, "jna": a <= b,
        "jg": sa > sb, "jnle": sa > sb, "jge": sa >= sb, "jnl": sa >= sb,
        "jl": sa < sb, "jnge": sa < sb, "jle": sa <= sb, "jng": sa <= sb,
        "js": bool(diff & 0x80000000), "jns": not diff & 0x80000000,
    }.get(mnem)


def run_latest_path(binary, start, mode):
    """Interpret from the DRS value load at `start` as if it read LATEST.

    Register values are tagged with where they came from: "latest" (the DRS
    value), "mode" (the first other DWORD loaded from memory, taken to be the
    quality mode) or "imm". Returns the first preset-sized constant stored to
    memory after the DRS value has been tested, or None if the path leaves what
    this interpreter understands.
    """
    regs, flags, mode_loc, tested = {}, None, None, False
    _, _, ops, _ = binary.insns[start]
    regs[canon_reg(ops.split(",", 1)[0])] = (LATEST, "latest")
    i = start + 1

    def value(op):
        nonlocal mode_loc
        v = imm(op)
        if v is not None:
            return v, "imm"
        if is_mem(op):
            if not op.startswith("DWORD"):
                return None, None
            if mode_loc is None:
                mode_loc = op
            return (mode, "mode") if op == mode_loc else (None, None)
        return regs.get(canon_reg(op), (None, None))

    def jump(op):
        t = target(op)
        return binary.index.get(t) if t is not None else None

    for _ in range(300):
        if i is None or i >= len(binary.insns):
            return None
        _, mnem, ops, _ = binary.insns[i]
        dst, _, src = ops.partition(",")
        reg = canon_reg(dst)
        if mnem == "jmp":
            i = jump(dst)
            continue
        if mnem.startswith("j"):
            taken = cond_taken(mnem, flags) if flags else None
            if taken is None:
                return None
            if taken:
                i = jump(dst)
                continue
        elif mnem in ("mov", "movsxd", "movzx"):
            if is_mem(dst):
                v, kind = value(src)
                if (tested and kind == "imm" and v is not None
                        and 1 <= v <= MAX_PRESET and dst.startswith("DWORD")):
                    return v
            elif reg:
                regs[reg] = value(src)
        elif mnem in ("cmp", "test", "sub", "add"):
            (a, ka), (b, kb) = value(dst), value(src)
            if a is None or b is None:
                return None
            tested |= "latest" in (ka, kb)
            kind = ka if ka != "imm" else kb
            if mnem == "test":
                flags = (a & b, 0)
            elif mnem == "add":
                flags = ((a + b) & 0xFFFFFFFF, 0)
                regs[reg] = (flags[0], kind)
            else:
                flags = (a, b)
                if mnem == "sub":
                    regs[reg] = ((a - b) & 0xFFFFFFFF, kind)
        elif mnem == "xor" and reg and canon_reg(src) == reg:
            regs[reg], flags = (0, "imm"), (0, 0)
        elif mnem == "call":
            for r in CALLER_SAVED[binary.abi]:
                regs.pop(r, None)
            flags = None
        elif mnem in ("ret", "int3", "ud2", "(bad)", "hlt"):
            return None
        elif mnem not in ("nop", "xchg", "push"):
            # lea, cmov*, set*, pop and anything unexpected: result unknown;
            # anything but lea/cmov/set may also change the flags.
            if reg:
                regs[reg] = (None, None)
            if not (mnem == "lea" or mnem.startswith(("cmov", "set"))):
                flags = None
        i += 1
    return None


def resolve_latest(binary, drs_id, modes):
    """Per-mode LATEST result from the first DRS value load that resolves."""
    load = re.compile(r"(\w+),DWORD PTR \[")
    for i in binary.refs_to_imm(drs_id):
        for j in range(i + 1, min(i + 60, len(binary.insns))):
            _, mnem, ops, _ = binary.insns[j]
            if mnem in ("mov", "movsxd") and load.match(ops) and canon_reg(ops.split(",")[0]):
                res = [run_latest_path(binary, j, m) for m in range(modes)]
                if None not in res:
                    return res
    return None


def per_mode_defaults(binary, prefix):
    """{callee: {mode_idx: default}} from `<prefix>.Hint.Render.Preset.<Mode>` call sites."""
    found = {}
    for mode_idx, (_, suffix) in enumerate(MODES):
        targets = set(binary.vaddrs_of(f"{prefix}.Hint.Render.Preset.{suffix}"))
        if not targets:
            continue
        for i, (_, _, _, ref) in enumerate(binary.insns):
            if ref not in targets:
                continue
            default = None
            for j in range(i + 1, min(i + 16, len(binary.insns))):
                _, mnem, ops, _ = binary.insns[j]
                if mnem == "call":
                    callee = target(ops)
                    if default is not None and callee is not None:
                        found.setdefault(callee, {})[mode_idx] = default
                    break
                if mnem == "mov":
                    dst, _, src = ops.partition(",")
                    v = imm(src)
                    if v is not None and 1 <= v <= MAX_PRESET and (
                            canon_reg(dst) in ("rcx", "rdx", "r8", "r9") or "[rsp+" in dst):
                        default = v
    return found


def callee_checks_latest(binary, addr):
    i = binary.index.get(addr)
    if i is None:
        return False
    for j in range(i, min(i + 150, len(binary.insns))):
        _, mnem, ops, _ = binary.insns[j]
        if mnem == "cmp" and ops.endswith(f",0x{LATEST:x}"):
            return True
        if mnem in ("ret", "int3"):
            return False
    return False


def analyze(binary, name, drs_id, prefix):
    print(f"{name}:")
    modes = len(MODES) if prefix else 1
    init = resolve_latest(binary, drs_id, modes)
    helpers = {c: d for c, d in per_mode_defaults(binary, prefix).items()
               if len(d) == len(MODES)} if prefix else {}
    eval_helpers = [c for c in helpers if callee_checks_latest(binary, c)]

    if eval_helpers:
        final = [helpers[eval_helpers[0]][m] for m in range(len(MODES))]
        how = "per-mode default preset, resolved per quality mode at evaluation"
    elif init is None:
        print("  could not find how 'latest' (0x00FFFFFF) is handled; this version")
        print("  may not support it, or the code layout is not understood\n")
        return
    else:
        final = init
        if len(set(init)) == 1:
            how = "fixed preset, independent of quality mode"
        else:
            how = ("resolved once at feature creation from the DRS quality mode "
                   "override (Performance if unset), not the game's mode")

    notes = binary.preset_notes()
    if not prefix:
        note = f" ({notes[final[0]]})" if final[0] in notes else ""
        print(f"  'latest' = {preset_name(final[0])}{note}\n")
        return
    print(f"  'latest' = {how}")
    width = max(len(m) for m, _ in MODES)
    for m, (mode, _) in enumerate(MODES):
        print(f"    {mode:<{width}}  {preset_name(final[m])}")
    print()


def is_x86_64(path):
    with open(path, "rb") as f:
        head = f.read(4096)
    if head[:4] == b"\x7fELF":
        return head[18:20] == b"\x3e\x00"
    if head[:2] == b"MZ":
        pe = int.from_bytes(head[0x3C:0x40], "little")
        return head[pe:pe + 6] == b"PE\0\0\x64\x86"
    return False


def main():
    if len(sys.argv) < 2:
        sys.exit(f"usage: {sys.argv[0]} <nvngx_dlss*.dll | libnvidia-ngx-dlss*.so> ...")
    for path in sys.argv[1:]:
        if not is_x86_64(path):
            print(f"== {path}\n  skipped: not an x86-64 ELF or PE library\n")
            continue
        binary = Binary(path)
        print(f"== {path} (version {binary.version()})")
        if binary.refs_to_imm(DRS_RR_PRESET):
            analyze(binary, "Ray Reconstruction", DRS_RR_PRESET, "RayReconstruction")
        elif binary.refs_to_imm(DRS_SR_PRESET):
            analyze(binary, "Super Resolution", DRS_SR_PRESET, "DLSS")
        elif binary.refs_to_imm(DRS_FG_PRESET):
            analyze(binary, "Frame Generation", DRS_FG_PRESET, None)
        elif binary.refs_to_imm(DRS_FG_MFG_COUNT):
            print("Frame Generation:\n  no render preset override setting in this version\n")
        else:
            print("  no DLSS render preset override setting found\n")


if __name__ == "__main__":
    main()
