#!/usr/bin/env python3
"""
Script to set LaunchOptions for Steam games to use proton-env-setup
"""

import os
import re
import struct
import sys
from pathlib import Path

# Configuration
STEAM_USER_ID = None  # Detected from the most recently logged in user when None
LAUNCH_OPTION = "~/.local/bin/proton-env-setup %command%"

# Paths
STEAM_DIR = Path("~/.local/share/Steam").expanduser()
STEAMAPPS_DIR = STEAM_DIR / "steamapps"
APPINFO_PATH = STEAM_DIR / "appcache" / "appinfo.vdf"
LOGINUSERS_PATH = STEAM_DIR / "config" / "loginusers.vdf"

# The userdata folder is named after the account ID, the low 32 bits of the SteamID64
STEAMID64_BASE = 76561197960265728

def localconfig_path(user_id):
    """Path of the localconfig.vdf file of a Steam user"""
    return STEAM_DIR / "userdata" / str(user_id) / "config" / "localconfig.vdf"

def detect_steam_user_id():
    """Find the Steam user ID of the most recently logged in user"""
    try:
        content = LOGINUSERS_PATH.read_text(encoding='utf-8')
    except OSError:
        content = ''

    users = []
    for match in re.finditer(r'"(\d{17})"\s*\{([^}]*)\}', content):
        fields = dict(re.findall(r'"(\w+)"\s+"([^"]*)"', match.group(2)))
        timestamp = fields.get('timestamp', '0')
        users.append((fields.get('MostRecent') == '1',
                      int(timestamp) if timestamp.isdigit() else 0,
                      int(match.group(1)) - STEAMID64_BASE))

    for _, _, user_id in sorted(users, reverse=True):
        if localconfig_path(user_id).exists():
            return str(user_id)

    # Fall back to the only user with a local configuration
    found = [p.parents[1].name for p in (STEAM_DIR / "userdata").glob("*/config/localconfig.vdf")]
    return found[0] if len(found) == 1 else None

def parse_acf(file_path):
    """Parse an ACF file and extract appid and name"""
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()

        appid_match = re.search(r'"appid"\s+"(\d+)"', content)
        name_match = re.search(r'"name"\s+"([^"]+)"', content)

        if appid_match and name_match:
            return {
                'appid': appid_match.group(1),
                'name': name_match.group(1)
            }
    except Exception as e:
        print(f"Error parsing {file_path}: {e}", file=sys.stderr)

    return None

def should_skip(name):
    """Check if the game name should be skipped"""
    name_lower = name.lower()
    return name_lower.startswith('steam') or name_lower.startswith('proton') or 'runtime' in name_lower

def read_appinfo(file_path, appids):
    """Parse Steam's binary appinfo.vdf cache and return the data of the given appids"""
    data = file_path.read_bytes()
    magic, = struct.unpack_from('<I', data, 0)

    def read_string(pos):
        end = data.index(b'\0', pos)
        return data[pos:end].decode('utf-8', 'replace'), end + 1

    # Version 29 stores the keys as indexes into a string table at the end of the file
    if magic == 0x07564429:
        table_offset, = struct.unpack_from('<q', data, 8)
        count, = struct.unpack_from('<I', data, table_offset)
        strings = []
        pos = table_offset + 4
        for _ in range(count):
            string, pos = read_string(pos)
            strings.append(string)
        pos = 16
    elif magic == 0x07564428:
        strings = None
        pos = 8
    else:
        raise ValueError(f"unsupported appinfo.vdf version {magic:#x}")

    def read_key(pos):
        if strings is None:
            return read_string(pos)
        index, = struct.unpack_from('<I', data, pos)
        return strings[index], pos + 4

    def read_section(pos):
        section = {}
        while True:
            value_type = data[pos]
            pos += 1
            if value_type in (0x08, 0x0b):
                return section, pos
            key, pos = read_key(pos)
            if value_type == 0x00:
                section[key], pos = read_section(pos)
            elif value_type == 0x01:
                section[key], pos = read_string(pos)
            elif value_type in (0x02, 0x04, 0x06):
                section[key], = struct.unpack_from('<i', data, pos)
                pos += 4
            elif value_type == 0x03:
                section[key], = struct.unpack_from('<f', data, pos)
                pos += 4
            elif value_type == 0x07:
                section[key], = struct.unpack_from('<Q', data, pos)
                pos += 8
            elif value_type == 0x0a:
                section[key], = struct.unpack_from('<q', data, pos)
                pos += 8
            else:
                raise ValueError(f"unknown value type {value_type:#x} in appinfo.vdf")

    apps = {}
    while True:
        appid, size = struct.unpack_from('<II', data, pos)
        if appid == 0:
            break
        if str(appid) in appids:
            # The binary VDF data follows 60 bytes of per-app metadata
            apps[str(appid)], _ = read_section(pos + 8 + 60)
        pos += 8 + size

    return apps

def is_vr_only(appinfo):
    """Check if the app can only be played in VR"""
    common = appinfo.get('appinfo', {}).get('common', {})
    return str(common.get('onlyvrsupport', 0)) == '1'

def is_tool(appinfo):
    """Check if the app is a tool (Proton, Steam Linux Runtime, SteamVR, etc.)"""
    common = appinfo.get('appinfo', {}).get('common', {})
    return str(common.get('type', '')).lower() == 'tool'

def read_vdf_file(file_path):
    """Read the VDF file"""
    with open(file_path, 'r', encoding='utf-8') as f:
        return f.read()

def write_vdf_file(file_path, content):
    """Write the VDF file"""
    # Create backup
    backup_path = str(file_path) + '.backup'
    if os.path.exists(file_path):
        import shutil
        shutil.copy2(file_path, backup_path)

    with open(file_path, 'w', encoding='utf-8') as f:
        f.write(content)

def find_app_section_bounds(vdf_content, start_pos):
    """Find the closing brace for an app section starting at start_pos

    start_pos should be right after the opening brace of the app section,
    so we start with brace_count=1 to account for that already-matched brace.
    """
    brace_count = 1  # Start at 1 because the opening brace was already matched

    for i in range(start_pos, len(vdf_content)):
        if vdf_content[i] == '{':
            brace_count += 1
        elif vdf_content[i] == '}':
            brace_count -= 1
            if brace_count == 0:
                return i

    return -1

def update_launch_options(vdf_content, appid, launch_option):
    """
    Update or add LaunchOptions for a specific appid in the VDF content
    """
    # Pattern to find the app section - match "appid" followed by opening brace
    # We need to be at the right level in the apps section
    app_pattern = rf'(\t+)"{appid}"\s*\n\s*{{'

    match = re.search(app_pattern, vdf_content)
    if not match:
        # App section doesn't exist, create it in the apps section
        apps_pattern = r'(\t+)"apps"\s*\n\s*{'
        apps_match = re.search(apps_pattern, vdf_content)

        if apps_match:
            base_indent = apps_match.group(1)
            app_indent = base_indent + '\t'
            content_indent = app_indent + '\t'

            # Insert new app section after the opening brace
            insert_pos = apps_match.end()
            new_app_section = f'\n{app_indent}"{appid}"\n{app_indent}{{\n{content_indent}"LaunchOptions"\t\t"{launch_option}"\n{app_indent}}}'
            vdf_content = vdf_content[:insert_pos] + new_app_section + vdf_content[insert_pos:]
            return vdf_content
        else:
            print(f"Warning: Could not find apps section for appid {appid}", file=sys.stderr)
            return vdf_content

    # App section exists
    base_indent = match.group(1)
    content_indent = base_indent + '\t'
    start_pos = match.start()

    # Find the closing brace for this app section
    section_start = match.end()
    end_pos = find_app_section_bounds(vdf_content, section_start)

    if end_pos == -1:
        print(f"Warning: Could not find end of app section for appid {appid}", file=sys.stderr)
        return vdf_content

    # Extract the app section content (between the braces)
    app_section = vdf_content[start_pos:end_pos + 1]

    # Remove all existing LaunchOptions lines using regex
    # This removes any line containing "LaunchOptions" with any value
    # Use [\s\t]* to match any whitespace including tabs
    app_section_no_launch = re.sub(r'[ \t]*"LaunchOptions"[ \t]+"[^"]*"[ \t]*\n', '', app_section)

    # Now add the LaunchOptions at the beginning of the section
    # Find the position right after the opening brace
    lines = app_section_no_launch.split('\n')

    # Insert LaunchOptions after the opening brace (which should be line 1)
    new_line = f'{content_indent}"LaunchOptions"\t\t"{launch_option}"'
    lines.insert(2, new_line)  # Insert after appid line and opening brace

    new_app_section = '\n'.join(lines)

    # Replace in the full content
    vdf_content = vdf_content[:start_pos] + new_app_section + vdf_content[end_pos + 1:]

    return vdf_content

def remove_launch_options(vdf_content, appid):
    """
    Remove LaunchOptions for a specific appid if it uses proton-env-setup
    """
    match = re.search(rf'(\t+)"{appid}"\s*\n\s*{{', vdf_content)
    if not match:
        return vdf_content, False

    start_pos = match.start()
    end_pos = find_app_section_bounds(vdf_content, match.end())
    if end_pos == -1:
        print(f"Warning: Could not find end of app section for appid {appid}", file=sys.stderr)
        return vdf_content, False

    app_section = vdf_content[start_pos:end_pos + 1]
    # Older versions of this script used a different path for proton-env-setup
    new_app_section, count = re.subn(
        r'[ \t]*"LaunchOptions"[ \t]+"[^"]*proton-env-setup[^"]*"[ \t]*\n', '', app_section)

    return vdf_content[:start_pos] + new_app_section + vdf_content[end_pos + 1:], count > 0

def main():
    # Get all appmanifest files
    manifest_files = sorted(STEAMAPPS_DIR.glob("appmanifest_*.acf"))

    if not manifest_files:
        print("No appmanifest files found!", file=sys.stderr)
        return 1

    # Parse all manifests and filter
    games = [info for info in map(parse_acf, manifest_files) if info]

    try:
        appinfo = read_appinfo(APPINFO_PATH, {game['appid'] for game in games})
    except (OSError, ValueError, struct.error) as e:
        print(f"Warning: cannot read {APPINFO_PATH}, VR games and tools will not be skipped: {e}", file=sys.stderr)
        appinfo = {}

    games_to_update = []
    vr_games = []

    for game_info in games:
        if should_skip(game_info['name']) or is_tool(appinfo.get(game_info['appid'], {})):
            continue
        if is_vr_only(appinfo.get(game_info['appid'], {})):
            vr_games.append(game_info)
            continue
        games_to_update.append(game_info)

    if not games_to_update and not vr_games:
        print("No games to update (all excluded)")
        return 0

    user_id = STEAM_USER_ID or detect_steam_user_id()
    if not user_id:
        print("Error: cannot detect the Steam user ID, set STEAM_USER_ID at the top of the script", file=sys.stderr)
        return 1

    # Read the localconfig.vdf file
    localconfig = localconfig_path(user_id)
    if not localconfig.exists():
        print(f"Error: {localconfig} not found!", file=sys.stderr)
        return 1

    vdf_content = read_vdf_file(localconfig)

    for game in vr_games:
        vdf_content, removed = remove_launch_options(vdf_content, game['appid'])
        if removed:
            print(f"Removing launch option from VR game: {game['name']} (ID: {game['appid']})")
        else:
            print(f"Skipping VR game: {game['name']} (ID: {game['appid']})")

    # Update each game
    for game in games_to_update:
        print(f"Processing: {game['name']} (ID: {game['appid']})")
        vdf_content = update_launch_options(vdf_content, game['appid'], LAUNCH_OPTION)

    # Write back the modified content
    write_vdf_file(localconfig, vdf_content)

    print(f"\nSuccessfully updated {len(games_to_update)} game(s)")
    print(f"Backup saved to: {localconfig}.backup")

    return 0

if __name__ == "__main__":
    sys.exit(main())
